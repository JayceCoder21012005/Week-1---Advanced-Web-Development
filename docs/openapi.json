                  "type": "string",
                  "format": "uuid"
                }
              },
              "Location": {
                "description": "URL của cart mới",
                "schema": {
                  "type": "string",
                  "example": "/carts/{cartId}"
                }
              }
            },
            "content": {
              "application/json": {
