{
  "openapi": "3.1.0",
  "info": {
    "title": "Cart API",
    "version": "1.0.0",
    "description": "RESTful Cart API. Mọi lỗi theo error contract `{ code, message, details, request_id }`; `request_id` trùng header `X-Request-Id` và dòng log trên server."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "CART_NOT_FOUND",
              "ITEM_NOT_FOUND",
              "PRODUCT_UNAVAILABLE",
              "INSUFFICIENT_STOCK",
              "ITEM_ALREADY_IN_CART",
              "CART_CLOSED",
              "NOT_FOUND",
              "INTERNAL_ERROR"
            ],
            "description": "Mã cố định để client rẽ nhánh"
          },
          "message": {
            "type": "string",
            "description": "Chỉ để hiển thị cho người dùng"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "issue"
              ]
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Trùng với header X-Request-Id và dòng log"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ]
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "price_cents",
          "stock"
        ],
        "example": {
          "id": "11111111-1111-4111-8111-111111111111",
          "sku": "KB-001",
          "name": "Mechanical Keyboard",
          "price_cents": 120000,
          "stock": 20
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "checked_out"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "subtotal_cents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "status",
          "items",
          "subtotal_cents"
        ],
        "example": {
          "id": "0b8f4c7e-5d2a-4f1b-9c3e-7a6d5e4f3b21",
          "status": "open",
          "items": [
            {
              "product_id": "11111111-1111-4111-8111-111111111111",
              "sku": "KB-001",
              "name": "Mechanical Keyboard",
              "unit_price_cents": 120000,
              "quantity": 2,
              "line_total_cents": 240000
            }
          ],
          "subtotal_cents": 240000
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit_price_cents": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "line_total_cents": {
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "sku",
          "name",
          "unit_price_cents",
          "quantity",
          "line_total_cents"
        ]
      },
      "AddItemRequest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "example": 2
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "additionalProperties": false
      },
      "UpdateItemRequest": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "example": 2
          }
        },
        "required": [
          "quantity"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "tags": [
          "Products"
        ],
        "summary": "Danh sách product đang bán",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Số product mỗi trang (1-50)",
              "example": 20
            },
            "required": false,
            "description": "Số product mỗi trang (1-50)",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0,
              "description": "Bỏ qua bao nhiêu product",
              "example": 0
            },
            "required": false,
            "description": "Bỏ qua bao nhiêu product",
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Trang product",
            "headers": {
              "X-Request-Id": {
                "description": "Mã request, trùng với request_id trong body lỗi và log",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "400": {
            "description": "Request sai schema (path, query hoặc body)",
            "headers": {
              "X-Request-Id": {
                "description": "Mã request, trùng với request_id trong body lỗi và log",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "quantityTooBig": {
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Request không hợp lệ",
                      "details": [
                        {
                          "field": "quantity",
                          "issue": "must be <= 10"
                        }
                      ],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  },
                  "unknownField": {
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Request không hợp lệ",
                      "details": [
                        {
                          "field": "price",
                          "issue": "is not allowed"
                        }
                      ],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  },
                  "badCartId": {
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Request không hợp lệ",
                      "details": [
                        {
                          "field": "cartId",
                          "issue": "must be a valid uuid"
                        }
                      ],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi hệ thống (vd: DB không kết nối được) — không chứa stack trace",
            "headers": {
              "X-Request-Id": {
                "description": "Mã request, trùng với request_id trong body lỗi và log",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "internal": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "Lỗi hệ thống, vui lòng thử lại sau",
                      "details": [],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
