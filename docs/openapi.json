    "/carts/{cartId}/items": {
      "post": {
        "operationId": "addCartItem",
        "tags": [
          "Cart items"
        ],
        "summary": "Thêm product vào cart",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "0b8f4c7e-5d2a-4f1b-9c3e-7a6d5e4f3b21"
            },
            "required": true,
            "name": "cartId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "valid": {
                  "value": {
                    "product_id": "11111111-1111-4111-8111-111111111111",
                    "quantity": 2
                  }
                },
                "quantityZero": {
                  "summary": "Sai: quantity = 0 → 400",
                  "value": {
                    "product_id": "11111111-1111-4111-8111-111111111111",
                    "quantity": 0
                  }
                },
                "quantityString": {
                  "summary": "Sai: quantity = \"2\" → 400",
                  "value": {
                    "product_id": "11111111-1111-4111-8111-111111111111",
                    "quantity": "2"
                  }
                },
                "inactiveProduct": {
                  "summary": "Product ngừng bán → 422",
                  "value": {
                    "product_id": "55555555-5555-4555-8555-555555555555",
                    "quantity": 1
                  }
                },
                "overStock": {
                  "summary": "Vượt tồn kho → 409",
                  "value": {
                    "product_id": "22222222-2222-4222-8222-222222222222",
                    "quantity": 6
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AddItemRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cart sau khi thêm",
            "headers": {
              "X-Request-Id": {
                "description": "Mã request, trùng với request_id trong body lỗi và log",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "400": {
            "description": "Request sai schema (path, query hoặc body)",
            "headers": {
              "X-Request-Id": {
                "description": "Mã request, trùng với request_id trong body lỗi và log",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "quantityTooBig": {
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Request không hợp lệ",
                      "details": [
                        {
                          "field": "quantity",
                          "issue": "must be <= 10"
                        }
                      ],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  },
                  "unknownField": {
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Request không hợp lệ",
                      "details": [
                        {
                          "field": "price",
                          "issue": "is not allowed"
                        }
                      ],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  },
                  "badCartId": {
                    "value": {
                      "code": "VALIDATION_ERROR",
                      "message": "Request không hợp lệ",
                      "details": [
                        {
                          "field": "cartId",
                          "issue": "must be a valid uuid"
                        }
                      ],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "cartId không tồn tại",
