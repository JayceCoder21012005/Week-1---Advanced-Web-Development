                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  },
                  "already": {
                    "value": {
                      "code": "ITEM_ALREADY_IN_CART",
                      "message": "Product đã có trong cart, hãy dùng PATCH để đổi số lượng",
                      "details": [],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Body đúng schema nhưng product không tồn tại hoặc ngừng bán",
            "headers": {
              "X-Request-Id": {
                "description": "Mã request, trùng với request_id trong body lỗi và log",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "productUnavailable": {
                    "value": {
                      "code": "PRODUCT_UNAVAILABLE",
                      "message": "Product không tồn tại hoặc đã ngừng bán",
                      "details": [],
                      "request_id": "7f3c2a9e-1b4d-4c8a-9e21-5d6f0a3b8c10"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi hệ thống (vd: DB không kết nối được) — không chứa stack trace",
